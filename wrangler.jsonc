{
  "name": "mini-flytripvisa-template",
  "main": "src/index.ts",
  "compatibility_date": "2024-10-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./"
  },
  "routes": [
    {
      "pattern": "/api/ai-chat",
      "custom_domain": false
    }
  ],
  "env": {
    "production": {
      "vars": {
        "MUSE_API_URL": "https://api.meta.ai/v1/chat/completions",
        "MUSE_MODEL": "muse-spark-1.3"
      }
    }
  }
}
